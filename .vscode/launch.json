{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Development",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "args": [
        "--flavor",
        "development"
      ],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Flutter Production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "args": [
        "--flavor",
        "production"
      ],
      "cwd": "${workspaceFolder}"
    }
  ],
  "compounds": [
    {
      "name": "Default Flutter Run",
      "configurations": ["Flutter Development"]
    }
  ]
}
